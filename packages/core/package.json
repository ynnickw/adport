{
  "name": "@adport/core",
  "version": "0.7.0",
  "description": "adport core: provider interface, tool registry, policy engine, credential store",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./tool-catalog": {
      "types": "./dist/tool-catalog.d.ts",
      "import": "./dist/tool-catalog.js"
    },
    "./media-platforms": {
      "types": "./dist/media-platforms.d.ts",
      "import": "./dist/media-platforms.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/media-platforms.ts src/tool-catalog.ts --format esm --dts --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "yaml": "^2.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.3.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ynnickw/adport.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ynnickw/adport#readme",
  "bugs": {
    "url": "https://github.com/ynnickw/adport/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
