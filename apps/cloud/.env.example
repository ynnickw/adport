# Copy to .env.local. Never commit the populated file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=from_supabase_status
SUPABASE_SECRET_KEY=from_supabase_status
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
ADPORT_DB_ROLE=adport_backend

ADPORT_CLOUD_BASE_URL=http://localhost:3000
# Generate independently: openssl rand -base64 32
ADPORT_CLOUD_ENCRYPTION_KEY=base64_encoded_32_byte_key
# Generate independently: openssl rand -hex 32
ADPORT_API_KEY_PEPPER=random_server_side_pepper
# Generate independently: openssl rand -base64 32
ADPORT_MCP_OAUTH_SIGNING_KEY=base64_encoded_32_byte_key

# ── Adport-owned provider applications (hosted OAuth broker) ───────────────
# Every OAuth-capable provider is connected through an application that Adport
# owns and registers with the platform. Tenants never supply these values. A
# provider card in Connections stays "Awaiting app approval" until its block is
# fully configured. Register the exact callback for each provider:
#   ${ADPORT_CLOUD_BASE_URL}/api/oauth/<provider>/callback

# Google Ads — Cloud Console web client in the verified project + developer token.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional manager account ID without dashes.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Meta Ads — Business app with Marketing API + Facebook Login for Business (ads_read, ads_management).
META_APP_ID=
META_APP_SECRET=
# Optional Graph API version override, e.g. v23.0
META_API_VERSION=

# TikTok Ads — TikTok for Business Marketing API app (production, not sandbox).
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Microsoft Advertising — Entra web app (confidential client) + Adport's own developer token.
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_DEVELOPER_TOKEN=

# Reddit Ads — Reddit "web app" OAuth client + honest User-Agent (e.g. web:cloud.adport:v1 (by /u/yourname)).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# Apple Ads — Apple-approved service-provider registration. Store the matching
# EC private key only in server environment secrets; tenants receive delegated
# authorization through Apple's consent flow.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_PRIVATE_KEY=
